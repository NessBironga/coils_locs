# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# PostgreSQL connection string used by Prisma (see prisma.config.ts and
# src/lib/db.ts). For local development against a Postgres instance
# running on your machine, this typically looks like:
#   postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
# For a hosted provider (e.g. Supabase, Neon), use the connection string
# they give you.
DATABASE_URL=
