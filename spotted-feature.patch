+// Content model + data for SPOTTED — STRUKS's editorial series
+// documenting real hair journeys and the people behind them.
+//
+// This follows the same pattern as src/data/products.ts: a typed data
+// file rather than a database table, since the rest of the app doesn't
+// have Prisma wired up yet (see src/lib/db.ts).
+//
+// IMPORTANT: no real participant stories or photographs exist yet. Every
+// entry below is placeholder content, explicitly flagged via
+// `isPlaceholder`, so it can never be mistaken for a real contribution.
+// Replace/remove placeholders as real SPOTTED entries are collected.
+
+export type SpottedCategory =
+  | "Locs"
+  | "Coils"
+  | "Curls"
+  | "Protective Styles"
+  | "Other";
+
+export const SPOTTED_CATEGORIES: SpottedCategory[] = [
+  "Locs",
+  "Coils",
+  "Curls",
+  "Protective Styles",
+  "Other",
+];
+
+export type SpottedEntry = {
+  /** Sequential SPOTTED number, shown as e.g. "SPOTTED / 001". */
+  number: number;
+  slug: string;
+  category: SpottedCategory;
+
+  /** Set anonymous=true and omit participantName to publish without a name. */
+  participantName?: string;
+  anonymous: boolean;
+
+  location?: string;
+  /** Free-text descriptive metadata, e.g. "4C / natural", "Locs". */
+  hairType?: string;
+  /** Free-text, e.g. "4 years", "Since 2021" — optional, omit if unknown. */
+  hairJourney?: string;
+
+  /** Caption used on the photography placeholder until a real photo exists. */
+  imageCaption: string;
+  /** If true, the participant chose to have only their hair photographed. */
+  photographHairOnly: boolean;
+
+  hairQuestion: string;
+  hairAnswer: string;
+  lifeQuestion: string;
+  lifeAnswer: string;
+
+  /** Optional short editorial note from the STRUKS contributor. */
+  editorialNote?: string;
+
+  // --- Consent fields. Never rendered on the public site — see
+  // src/app/spotted/page.tsx and [slug]/page.tsx, which intentionally
+  // never read these two fields when building UI copy. They exist here
+  // so the data model is consent-aware from day one. ---
+  consentToPublish: boolean;
+  consentToSocial: boolean;
+
+  /** True while this is placeholder/sample content, not a real entry. */
+  isPlaceholder: boolean;
+};
+
+export const HAIR_QUESTION = "What's one thing you wish you knew?";
+export const LIFE_QUESTION = "What's one piece of advice you'd give anyone right now?";
+
+export const spottedEntries: SpottedEntry[] = [
+  {
+    number: 1,
+    slug: "001-nairobi-locs",
+    category: "Locs",
+    anonymous: false,
+    participantName: "M.",
+    location: "Nairobi",
+    hairType: "Locs",
+    hairJourney: "4 years",
+    imageCaption: "Detail shot, back of head — locs",
+    photographHairOnly: true,
+    hairQuestion: "What's one thing you wish you knew before starting locs?",
+    hairAnswer: "Don't retwist every time you think they look messy.",
+    lifeQuestion: LIFE_QUESTION,
+    lifeAnswer: "Stop rushing things that are supposed to take time.",
+    consentToPublish: true,
+    consentToSocial: false,
+    isPlaceholder: true,
+  },
+  {
+    number: 2,
+    slug: "002-mombasa-coils",
+    category: "Coils",
+    anonymous: true,
+    location: "Mombasa",
+    hairType: "4C / natural",
+    imageCaption: "Detail shot — coily texture, natural light",
+    photographHairOnly: true,
+    hairQuestion: "What's one thing you wish you knew about your coils?",
+    hairAnswer: "Placeholder answer — pending a real SPOTTED conversation.",
+    lifeQuestion: LIFE_QUESTION,
+    lifeAnswer: "Placeholder answer — pending a real SPOTTED conversation.",
+    consentToPublish: true,
+    consentToSocial: true,
+    isPlaceholder: true,
+  },
+  {
+    number: 3,
+    slug: "003-nakuru-protective-style",
+    category: "Protective Styles",
+    anonymous: false,
+    participantName: "A. Wanjiru",
+    location: "Nakuru",
+    hairType: "Box braids on natural hair",
+    imageCaption: "Full-length shot — protective style",
+    photographHairOnly: false,
+    hairQuestion: "What's one thing you wish you knew about protective styling?",
+    hairAnswer: "Placeholder answer — pending a real SPOTTED conversation.",
+    lifeQuestion: LIFE_QUESTION,
+    lifeAnswer: "Placeholder answer — pending a real SPOTTED conversation.",
+    consentToPublish: true,
+    consentToSocial: true,
+    isPlaceholder: true,
+  },
+];
+
+export function getSpottedEntry(slug: string) {
+  return spottedEntries.find((entry) => entry.slug === slug);
+}
