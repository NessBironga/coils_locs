@@ -0,0 +1,44 @@
+type SpottedPhotoPlaceholderProps = {
+  caption: string;
+  photographHairOnly: boolean;
+  className?: string;
+};
+
+/**
+ * Stand-in for a real SPOTTED photograph.
+ *
+ * SPOTTED is built around authentic, consented photography of real
+ * people's hair — not stock photos, and never AI-generated people. Since
+ * no real photographs exist yet, every image slot uses this graphic
+ * placeholder (a `role="img"` block with a descriptive label, not a
+ * fake <img>) so nothing here could be mistaken for a real participant.
+ */
+export function SpottedPhotoPlaceholder({
+  caption,
+  photographHairOnly,
+  className = "",
+}: SpottedPhotoPlaceholderProps) {
+  const label = `Photography placeholder: ${caption}${
+    photographHairOnly ? " (hair only, no face shown)" : ""
+  }. Pending a real photograph.`;
+
+  return (
+    <div
+      role="img"
+      aria-label={label}
+      className={`relative overflow-hidden bg-ink ${className}`}
+    >
+      <div
+        className="absolute inset-0 opacity-80"
+        style={{
+          backgroundImage:
+            "repeating-linear-gradient(45deg, #2a2419 0px, #2a2419 1px, transparent 1px, transparent 14px)",
+        }}
+        aria-hidden="true"
+      />
+      <div className="absolute bottom-0 left-0 right-0 border-t border-line-dark px-4 py-3 text-xs uppercase tracking-widest text-ink-soft">
+        <span>{caption}</span>
+      </div>
+    </div>
+  );
+}
