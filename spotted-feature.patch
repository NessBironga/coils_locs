+import Link from "next/link";
+import { SiteHeader } from "@/components/site-header";
+import { SiteFooter } from "@/components/site-footer";
+import { SpottedCard } from "@/components/spotted-card";
+import { SPOTTED_CATEGORIES, spottedEntries } from "@/data/spotted";
+
+export const metadata = {
+  title: "SPOTTED",
+  description:
+    "SPOTTED is STRUKS's collection of conversations with people we meet along the way — about their hair, what they've learned, and what they know beyond it.",
+};
+
+type SpottedPageProps = {
+  searchParams: Promise<{ category?: string }>;
+};
+
+export default async function SpottedPage({ searchParams }: SpottedPageProps) {
+  const { category } = await searchParams;
+  const activeCategory = SPOTTED_CATEGORIES.find((c) => c === category);
+
+  const entries = activeCategory
+    ? spottedEntries.filter((entry) => entry.category === activeCategory)
+    : spottedEntries;
+
+  return (
+    <>
+      <SiteHeader />
+      <main className="flex-1 bg-paper">
+        <div className="mx-auto max-w-content px-6 py-16">
+          <h1 className="font-serif text-3xl md:text-4xl">SPOTTED</h1>
+
+          <div className="mt-4 max-w-prose space-y-3 text-lg text-ink-soft">
+            <p>
+              <strong className="text-ink">
+                We notice good hair. We ask questions.
+              </strong>
+            </p>
+            <p>
+              SPOTTED is STRUKS&rsquo;s collection of conversations with
+              people we meet along the way — about their hair, what
+              they&rsquo;ve learned, and what they know beyond it.
+            </p>
+          </div>
+
+          <nav
+            aria-label="Filter SPOTTED by category"
+            className="mt-8 flex flex-wrap gap-3"
+          >
+            <Link
+              href="/spotted"
+              aria-current={!activeCategory ? "page" : undefined}
+              className={`inline-block rounded-full border px-4 py-2 text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-brass/60 ${
+                !activeCategory
+                  ? "border-brass bg-brass text-brass-ink"
+                  : "border-line bg-paper-raised text-ink hover:border-brass hover:text-brass"
+              }`}
+            >
+              All
+            </Link>
+            {SPOTTED_CATEGORIES.map((cat) => {
+              const isActive = cat === activeCategory;
+              return (
+                <Link
+                  key={cat}
+                  href={`/spotted?category=${encodeURIComponent(cat)}`}
+                  aria-current={isActive ? "page" : undefined}
+                  className={`inline-block rounded-full border px-4 py-2 text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-brass/60 ${
+                    isActive
+                      ? "border-brass bg-brass text-brass-ink"
+                      : "border-line bg-paper-raised text-ink hover:border-brass hover:text-brass"
+                  }`}
+                >
+                  {cat}
+                </Link>
+              );
+            })}
+          </nav>
+
+          {entries.length > 0 ? (
+            <div className="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
+              {entries.map((entry) => (
+                <SpottedCard key={entry.slug} entry={entry} />
+              ))}
+            </div>
+          ) : (
+            <p className="mt-10 text-ink-muted">
+              No SPOTTED entries in this category yet — check back soon.
+            </p>
+          )}
+        </div>
+      </main>
+      <SiteFooter />
+    </>
+  );
+}
