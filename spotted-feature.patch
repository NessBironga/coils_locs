+import type { Metadata } from "next";
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { SiteHeader } from "@/components/site-header";
+import { SiteFooter } from "@/components/site-footer";
+import { SpottedPhotoPlaceholder } from "@/components/spotted-photo-placeholder";
+import { getSpottedEntry, spottedEntries } from "@/data/spotted";
+
+type SpottedEntryPageProps = {
+  params: Promise<{ slug: string }>;
+};
+
+export function generateStaticParams() {
+  return spottedEntries.map((entry) => ({ slug: entry.slug }));
+}
+
+export async function generateMetadata({
+  params,
+}: SpottedEntryPageProps): Promise<Metadata> {
+  const { slug } = await params;
+  const entry = getSpottedEntry(slug);
+  if (!entry) return { title: "SPOTTED" };
+
+  const displayName = entry.anonymous
+    ? "Anonymous"
+    : entry.participantName ?? "Anonymous";
+
+  return {
+    title: `Spotted / ${String(entry.number).padStart(3, "0")} — ${displayName}`,
+    description: entry.hairAnswer,
+  };
+}
+
+export default async function SpottedEntryPage({
+  params,
+}: SpottedEntryPageProps) {
+  const { slug } = await params;
+  const entry = getSpottedEntry(slug);
+
+  if (!entry) {
+    notFound();
+  }
+
+  const displayName = entry.anonymous
+    ? "Anonymous"
+    : entry.participantName ?? "Anonymous";
+
+  return (
+    <>
+      <SiteHeader />
+      <main className="flex-1 bg-paper">
+        <div className="mx-auto max-w-content px-6 py-16">
+          <Link
+            href="/spotted"
+            className="text-sm text-ink-muted transition-colors hover:text-brass focus:outline-none focus:ring-2 focus:ring-brass/60"
+          >
+            ← Back to SPOTTED
+          </Link>
+
+          <div className="mt-6 grid gap-10 md:grid-cols-2 md:gap-14">
+            <SpottedPhotoPlaceholder
+              caption={entry.imageCaption}
+              photographHairOnly={entry.photographHairOnly}
+              className="h-96 w-full md:h-full"
+            />
+
+            <div>
+              <p className="text-xs uppercase tracking-widest text-ink-muted">
+                Spotted / {String(entry.number).padStart(3, "0")}
+                {entry.isPlaceholder && (
+                  <span className="ml-2 text-oxide">
+                    Sample entry — not a real participant
+                  </span>
+                )}
+              </p>
+
+              <h1 className="mt-3 font-serif text-3xl text-ink md:text-4xl">
+                {displayName}
+              </h1>
+
+              <dl className="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-ink-muted">
+                {entry.location && (
+                  <div className="flex gap-1.5">
+                    <dt className="font-medium text-ink">Location:</dt>
+                    <dd>{entry.location}</dd>
+                  </div>
+                )}
+                {entry.hairType && (
+                  <div className="flex gap-1.5">
+                    <dt className="font-medium text-ink">Hair:</dt>
+                    <dd>{entry.hairType}</dd>
+                  </div>
+                )}
+                {entry.hairJourney && (
+                  <div className="flex gap-1.5">
+                    <dt className="font-medium text-ink">Years:</dt>
+                    <dd>{entry.hairJourney}</dd>
+                  </div>
+                )}
+              </dl>
+
+              <section className="mt-8" aria-labelledby="hair-note-heading">
+                <h2
+                  id="hair-note-heading"
+                  className="text-xs uppercase tracking-widest text-ink-muted"
+                >
+                  Hair note
+                </h2>
+                <p className="mt-2 text-sm italic text-ink-muted">
+                  &ldquo;{entry.hairQuestion}&rdquo;
+                </p>
+                <blockquote className="mt-3 border-l-2 border-brass pl-4 font-serif text-xl leading-snug text-ink">
+                  {entry.hairAnswer}
+                </blockquote>
+              </section>
+
+              <section className="mt-8" aria-labelledby="life-note-heading">
+                <h2
+                  id="life-note-heading"
+                  className="text-xs uppercase tracking-widest text-ink-muted"
+                >
+                  Life note
+                </h2>
+                <p className="mt-2 text-sm italic text-ink-muted">
+                  &ldquo;{entry.lifeQuestion}&rdquo;
+                </p>
+                <blockquote className="mt-3 border-l-2 border-brass pl-4 font-serif text-xl leading-snug text-ink">
+                  {entry.lifeAnswer}
+                </blockquote>
+              </section>
+
+              {entry.editorialNote && (
+                <p className="mt-8 border-t border-line pt-6 text-sm text-ink-muted">
+                  {entry.editorialNote}
+                </p>
+              )}
+            </div>
+          </div>
+        </div>
+      </main>
+      <SiteFooter />
+    </>
+  );
+}
