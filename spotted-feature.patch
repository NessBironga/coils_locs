+import Link from "next/link";
+import type { SpottedEntry } from "@/data/spotted";
+import { SpottedPhotoPlaceholder } from "@/components/spotted-photo-placeholder";
+
+export function SpottedCard({ entry }: { entry: SpottedEntry }) {
+  const displayName = entry.anonymous
+    ? "Anonymous"
+    : entry.participantName ?? "Anonymous";
+
+  return (
+    <Link
+      href={`/spotted/${entry.slug}`}
+      className="group block border border-line bg-paper-raised transition-colors hover:border-brass focus:outline-none focus:ring-2 focus:ring-brass/60"
+    >
+      <SpottedPhotoPlaceholder
+        caption={entry.imageCaption}
+        photographHairOnly={entry.photographHairOnly}
+        className="h-56 w-full"
+      />
+      <div className="p-5">
+        <p className="text-xs uppercase tracking-widest text-ink-muted">
+          Spotted / {String(entry.number).padStart(3, "0")}
+          {entry.isPlaceholder && (
+            <span className="ml-2 text-oxide">Sample entry</span>
+          )}
+        </p>
+        <p className="mt-2 font-serif text-lg text-ink">
+          {entry.category}
+          {entry.location ? ` — ${entry.location}` : ""}
+        </p>
+        <p className="mt-2 text-sm text-ink-muted">{displayName}</p>
+        <span className="mt-4 inline-block text-sm text-brass transition-transform group-hover:translate-x-1">
+          Read more →
+        </span>
+      </div>
+    </Link>
+  );
+}
